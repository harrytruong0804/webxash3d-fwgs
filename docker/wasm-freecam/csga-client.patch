diff --git a/engine/client/cl_view.c b/engine/client/cl_view.c
index 0a35b734..f596b68a 100644
--- a/engine/client/cl_view.c
+++ b/engine/client/cl_view.c
@@ -366,6 +366,132 @@ V_RenderView
 
 ==================
 */
+
+/* ==== CSGA democam: camera tu do khi phat demo (xem democam.py) ==== */
+int democam_target = 0;   /* entity index nguoi dang bam; 0 = tat */
+int democam_chase  = 0;   /* 1 = bam sau lung, 0 = goc nhin thu nhat */
+
+void CL_DemoCam_f( void )
+{
+	if( Cmd_Argc() < 2 )
+	{
+		Con_Printf( "democam <entity#>  (0 = tat). Dang bam: %i\n", democam_target );
+		return;
+	}
+	democam_target = Q_atoi( Cmd_Argv( 1 ));
+	Con_Printf( "democam -> %i\n", democam_target );
+}
+
+static void CL_DemoCamStep( int dir )
+{
+	int i, n = cl.maxclients;
+	for( i = 0; i < n; i++ )
+	{
+		democam_target += dir;
+		if( democam_target < 1 ) democam_target = n;
+		if( democam_target > n ) democam_target = 1;
+		/* Bo qua CHINH may quay (local player cua demo — spectator REC):
+		 * khong co than the that, nhay vao la hinh vo. */
+		if( democam_target == cl.playernum + 1 ) continue;
+		cl_entity_t *e = CL_GetEntityByIndex( democam_target );
+		if( e && e->model ) { Con_Printf( "democam -> %i\n", democam_target ); return; }
+	}
+}
+void CL_DemoCamNext_f( void ) { CL_DemoCamStep( +1 ); }
+void CL_DemoCamPrev_f( void ) { CL_DemoCamStep( -1 ); }
+
+/* Bam nguoi choi theo TEN (tu log kill). cl.players[i] la slot i, entity i+1. */
+void CL_DemoCamName_f( void )
+{
+	int i, n = cl.maxclients, wlen;
+	const char *want;
+
+	if( Cmd_Argc() < 2 )
+	{
+		Con_Printf( "democam_name <ten nguoi choi>\n" );
+		return;
+	}
+	want = Cmd_Args();   /* ca ten, ke ca co khoang trang: "chicken (2)" */
+	wlen = Q_strlen( want );
+
+	/* khop chinh xac truoc */
+	for( i = 0; i < n; i++ )
+	{
+		if( !cl.players[i].name[0] ) continue;
+		if( !Q_stricmp( cl.players[i].name, want ))
+		{
+			democam_target = i + 1;
+			Con_Printf( "democam -> %s (entity %i)\n", cl.players[i].name, democam_target );
+			return;
+		}
+	}
+	/* khop tien to */
+	for( i = 0; i < n; i++ )
+	{
+		if( !cl.players[i].name[0] ) continue;
+		if( wlen > 0 && !Q_strnicmp( cl.players[i].name, want, wlen ))
+		{
+			democam_target = i + 1;
+			Con_Printf( "democam -> %s (entity %i, khop tien to)\n", cl.players[i].name, democam_target );
+			return;
+		}
+	}
+	Con_Printf( "democam_name: khong thay '%s'\n", want );
+}
+void CL_DemoCamChase_f( void )
+{
+	democam_chase = !democam_chase;
+	Con_Printf( "democam che do: %s\n", democam_chase ? "bam sau lung" : "goc nhin thu nhat" );
+}
+
+/* Ghi de vieworg/viewangles bang vi tri nguoi choi da chon. Goi NGAY sau
+ * pfnCalcRefdef trong V_RenderView. */
+static void CL_DemoCamApply( ref_params_t *rp )
+{
+	cl_entity_t	*ent;
+	vec3_t		org, ang, fwd;
+
+	if( !cls.demoplayback || democam_target <= 0 )
+		return;
+	ent = CL_GetEntityByIndex( democam_target );
+	if( !ent || !ent->model )
+		return;
+
+	/* In-eye: client dll tu dung (clientdata da duoc bom iuser1=4/iuser2 o
+	 * cl_frame.c) — goc noi suy + viewmodel sung nhu HLTV. Pitch: k=0 dung goc
+	 * ban sinh (angles ×-3); k khac 0 dung lai tu blending[1] (127=ngang),
+	 * kep ±40 do phong du lieu dong cung. */
+	/* Goc nhin: kenh `angles` DA du va chinh xac (server: angles[PITCH] =
+	 * -v_angle/3, yaw nguyen — sv_pmove.c) va client dll V_GetInEyePos tu dung
+	 * lai dung cong thuc do. KHONG de pitch/yaw nua (bai hoc: vuser2[0] ve 0
+	 * lam camera bi ep ngang — "lech len tren"). Chi CONG punchangle that
+	 * (vuser1, serverfill) vi duong spectator cua client dll khong tu cong. */
+	if( !democam_chase )
+	{
+		if( ent->curstate.vuser1[0] != 0.0f || ent->curstate.vuser1[1] != 0.0f )
+		{
+			rp->viewangles[PITCH] += ent->curstate.vuser1[0];
+			rp->viewangles[YAW] += ent->curstate.vuser1[1];
+		}
+		return;
+	}
+	ang[0] = ent->angles[0] * -3.0f;   /* chase: goc ban sinh (chinh xac) */
+	ang[1] = ent->angles[1];
+	ang[2] = 0.0f;
+
+	VectorCopy( ent->origin, org );
+	ang[1] = ent->angles[1];
+	ang[2] = 0.0f;
+
+	AngleVectors( ang, fwd, NULL, NULL );
+	VectorMA( org, -112.0f, fwd, org );   /* lui sau 112 don vi */
+	org[2] += 24.0f;
+
+	VectorCopy( org, rp->vieworg );
+	VectorCopy( ang, rp->viewangles );
+}
+/* ==== het democam ==== */
+
 void V_RenderView( void )
 {
 	// HACKHACK: make ref params static
@@ -387,6 +513,7 @@ void V_RenderView( void )
 	do
 	{
 		clgame.dllFuncs.pfnCalcRefdef( &rp );
+		CL_DemoCamApply( &rp );
 		V_GetRefParams( &rp, &rvp );
 		V_RefApplyOverview( &rvp );
 
