diff --git a/engine/client/cl_frame.c b/engine/client/cl_frame.c
index b0b66ad1..dba04d83 100644
--- a/engine/client/cl_frame.c
+++ b/engine/client/cl_frame.c
@@ -635,8 +635,95 @@ void CL_ProcessPacket( frame_t *frame )
 		ent->player = CL_IsPlayerIndex( state->number );
 
 		if( state->number == ( cl.playernum + 1 ))
+		{
+			extern int democam_target, democam_chase;
+			if( cls.demoplayback )
+			{
+				/* democam bat: de iuser cho client dll (banner/in-eye). Tat: giu
+				 * iuser goc cua demo. Ca hai truong hop deu synth CurWeapon cho
+				 * target dang xem — cam dau tien (chua democam) cung can crosshair. */
+				int dc_view = democam_target > 0 ? democam_target : frame->clientdata.iuser2;
+				cl_entity_t *dte = dc_view > 0 ? CL_GetEntityByIndex( dc_view ) : NULL;
+
+				if( democam_target > 0 )
+				{
+					frame->clientdata.iuser1 = democam_chase ? 2 : 4;
+					frame->clientdata.iuser2 = democam_target;
+					/* mau cua target neu demo co (entity_state.health); 0 = khong biet */
+					if( dte && dte->curstate.health > 0 )
+						frame->clientdata.health = dte->curstate.health;
+
+					/* Crosshair co/no theo TU THE target: g_iPlayerFlags cua client dll
+					 * an tu clientdata.flags qua duong prediction (da do: van chay khi
+					 * phat demo, flags=520 cua recorder — khong bao gio ngoi). Thay
+					 * bang tu the that: usehull==1 = dang ngoi -> crosshair thu nho. */
+					if( dte )
+					{
+						frame->clientdata.flags = ( frame->clientdata.flags & ~FL_DUCKING ) | FL_ONGROUND;
+						if( dte->curstate.usehull == 1 )
+							frame->clientdata.flags |= FL_DUCKING;
+
+						/* Du lieu THAT tu server (delta moi, serverfill dong fork):
+						 * velocity -> g_flPlayerSpeed (crosshair no khi chay),
+						 * vuser1 = punchangle (giat sung), fov = zoom AWP.
+						 * Demo cu chua co thi cac truong nay = 0 — vo hai. */
+						VectorCopy( dte->curstate.velocity, frame->clientdata.velocity );
+						VectorCopy( dte->curstate.vuser1, frame->clientdata.punchangle );
+						if( dte->curstate.fov > 0.0f )
+							frame->clientdata.fov = dte->curstate.fov;
+					}
+				}
+
+				/* Crosshair: client dll chi ve khi m_pWeapon duoc set boi usermessage
+				 * CurWeapon — demo CHI chua CurWeapon cua nguoi recorder bam luc ghi.
+				 * Tong hop CurWeapon tu p_ weaponmodel cua target (luon co trong demo). */
+				if( dte )
+				{
+					static int dc_last_ent, dc_last_wm = -1;
+					int wm = dte->curstate.weaponmodel;
+					if( wm != dc_last_wm || dc_view != dc_last_ent )
+					{
+						static const struct { const char *p; byte id; } dc_wtbl[] = {
+							{"p_p228",1},{"p_scout",3},{"p_hegrenade",4},{"p_xm1014",5},
+							{"p_c4",6},{"p_mac10",7},{"p_aug",8},{"p_smokegrenade",9},
+							{"p_elite",10},{"p_fiveseven",11},{"p_ump45",12},{"p_sg550",13},
+							{"p_galil",14},{"p_famas",15},{"p_usp",16},{"p_glock18",17},
+							{"p_awp",18},{"p_mp5",19},{"p_m249",20},{"p_m3",21},
+							{"p_m4a1",22},{"p_tmp",23},{"p_g3sg1",24},{"p_flashbang",25},
+							{"p_deagle",26},{"p_sg552",27},{"p_ak47",28},{"p_knife",29},
+							{"p_p90",30},
+						};
+						byte wbuf[3] = { 0, 0, 0 };
+						model_t *pm = wm ? CL_ModelHandle( wm ) : NULL;
+						if( pm && pm->name[0] )
+						{
+							size_t di;
+							for( di = 0; di < sizeof( dc_wtbl ) / sizeof( dc_wtbl[0] ); di++ )
+								if( Q_strstr( pm->name, dc_wtbl[di].p )) { wbuf[0] = 1; wbuf[1] = dc_wtbl[di].id; wbuf[2] = 1; break; }
+						}
+						/* wm=0 (chet/khong sung) -> state 0: an crosshair, dung nhu that */
+						CL_DispatchUserMessage( "CurWeapon", 3, wbuf );
+						dc_last_ent = dc_view; dc_last_wm = wm;
+					}
+					/* Zoom (AWP/Scout): client chi doi FOV qua usermessage SetFOV.
+					 * fov THAT nam trong state (serverfill) — synth khi doi. */
+					{
+						static int dc_last_fov = -1;
+						int fv = (int)dte->curstate.fov;
+						if( fv != dc_last_fov )
+						{
+							byte fbuf[1];
+							fbuf[0] = (byte)( fv > 0 && fv < 180 ? fv : 0 );
+							CL_DispatchUserMessage( "SetFOV", 1, fbuf );
+							dc_last_fov = fv;
+						}
+					}
+				}
+			}
 			clgame.dllFuncs.pfnTxferLocalOverrides( state, &frame->clientdata );
 
+		}
+
 		// shuffle states
 		ent->prevstate = ent->curstate;
 		ent->curstate = *state;
